# Kyros Praxis CrewAI API - Environment Configuration

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================

# Option 1: OpenRouter (Recommended - supports multiple models)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option 2: Direct OpenAI
# OPENAI_API_KEY=sk-...

# Model Selection
MODEL_PROVIDER=openrouter                          # openrouter | openai
MODEL_NAME=gpt-4o-mini                             # Model identifier (e.g., gpt-4o-mini, openrouter/openai/gpt-4o)

# ==============================================================================
# Database Configuration
# ==============================================================================

DATABASE_URL=postgresql+asyncpg://kyros:kyros@localhost:5432/kyros
DB_ECHO=false                                       # Set to 'true' to log SQL queries

# Test Database (for pytest)
TEST_DATABASE_URL=postgresql+asyncpg://kyros:kyros@localhost:5432/kyros_test

# ==============================================================================
# JWT Authentication
# ==============================================================================

# Generate a secure secret key with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-min-32-chars-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256                                 # HS256 (recommended) | HS512
JWT_EXPIRE_MINUTES=1440                             # Token expiration in minutes (1440 = 24 hours)

# ==============================================================================
# CORS & Security
# ==============================================================================

# Allowed CORS origins (comma-separated or JSON array)
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# Runtime Configuration
# ==============================================================================

KYROS_ENV=dev                                       # dev | staging | production
KYROS_STORAGE_DIR=./storage                         # Directory for future artifact storage

# ==============================================================================
# Notes
# ==============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. The API runs on port 8001 by default (to avoid conflict with legacy orchestrator on 8000)
# 4. For OpenRouter: Get an API key at https://openrouter.ai/keys
# 5. For JWT_SECRET_KEY: MUST be at least 32 characters for security
# 6. For local development, the default DATABASE_URL should work with docker-compose.yml
