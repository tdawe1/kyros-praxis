# Kyros Praxis Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# Application
NODE_ENV=production
APP_ENV=production
DEBUG=false

# Security
JWT_SECRET=<generate-with-openssl-rand-base64-32>
SESSION_SECRET=<generate-with-openssl-rand-base64-32>
ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
CSRF_SECRET=<generate-with-openssl-rand-base64-32>

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kyros
POSTGRES_USER=kyros_user
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=kyros
REDIS_URL=redis://localhost:6379

# API Configuration
API_BASE_URL=https://api.kyros-praxis.com
NEXT_PUBLIC_API_URL=https://api.kyros-praxis.com/api/v1
BACKEND_CORS_ORIGINS=https://kyros-praxis.com,https://www.kyros-praxis.com
FRONTEND_HOST=https://kyros-praxis.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
CSP_REPORT_URI=/api/csp-report

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=
LOG_LEVEL=info

# Feature Flags
NEXT_PUBLIC_FEATURE_AGENTS=true
NEXT_PUBLIC_FEATURE_TRANSLATIONS=false
NEXT_PUBLIC_FEATURE_INVENTORY=false
NEXT_PUBLIC_FEATURE_MARKETING=false