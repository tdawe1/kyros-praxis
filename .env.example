# Kyros Praxis Environment Configuration
# Copy this file to .env and set secure values

# ============================================
# REQUIRED - Must be set before running
# ============================================

# Database password (use strong password)
POSTGRES_PASSWORD=

# NextAuth secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=

# API Secret key (generate with: openssl rand -hex 32)
SECRET_KEY=

# ============================================
# OPTIONAL - Defaults provided
# ============================================

# Database
POSTGRES_DB=kyros
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6381

# Ports
CONSOLE_PORT=3001
ORCHESTRATOR_PORT=8000
SERVICE_REGISTRY_PORT=9000

# NextAuth
NEXTAUTH_URL=http://localhost:3001
