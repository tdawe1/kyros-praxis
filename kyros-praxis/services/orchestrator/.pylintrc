[MASTER]
init-hook='import sys; sys.path.append(".")'

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    invalid-name,
    no-member,
    import-error,
    wrong-import-order,
    consider-using-f-string,
    broad-exception-caught,
    bare-except,
    duplicate-code,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-lines,
    R0801

[REPORTS]
msg-template={path}:{line}: [{msg_id}({symbol}), {obj}] {msg}

[TYPECHECK]
ignored-modules=cv2,pygame,numpy

[VARIABLES]
dummy-variables-rgx=^_|dummy
init-import=no
additional-builtins=

[BASIC]
good-names=_,i,j,k,ex,Run,PK

[FORMAT]
max-line-length=120
indent-string='    '

[MISCELLANEOUS]
notes=FIXME,XXX,TODO

[SIMILARITIES]
min-similarity-lines=6
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[DESIGN]
max-args=10
max-attributes=15
min-public-methods=0
max-public-methods=50
max-returns=10
max-branches=20
max-statements=80
max-parents=10