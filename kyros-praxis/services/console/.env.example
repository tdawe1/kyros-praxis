# Environment variables for Kyros Praxis Console Service
# Copy this file to .env and fill in the values

NEXTAUTH_SECRET=your_very_secure_nextauth_secret_minimum_32_chars
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_AUTH_URL=http://localhost:8000

# Enable local login without backend (dev only)
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false

# Post-login redirect route (e.g., /agents, /jobs, /)
NEXT_PUBLIC_POST_LOGIN_ROUTE=/agents
